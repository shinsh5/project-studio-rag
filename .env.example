LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama2:7b
OLLAMA_TEMPERATURE=0.0
OLLAMA_SEED=42
OLLAMA_TOP_K=1
OLLAMA_TOP_P=1.0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=160
OLLAMA_NUM_BATCH=32
OLLAMA_KEEP_ALIVE=-1
OLLAMA_FRESH_RUNNER=false
LLM_RESPONSE_CACHE_DEFAULT=true
LLM_RESPONSE_CACHE_MAX_SIZE=128

# Only RAGAS faithfulness evaluation uses Codex CLI.
# CODEX_CLI_PATH=C:\Users\your-name\AppData\Roaming\npm\codex.cmd
CODEX_MODEL=gpt-5.6-luna
CODEX_TIMEOUT_SECONDS=300

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNKING_STRATEGY=roi_rag