LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama2:7b
OLLAMA_TEMPERATURE=0.0
OLLAMA_SEED=42
OLLAMA_TOP_K=1
OLLAMA_TOP_P=1.0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_BATCH=32
OLLAMA_KEEP_ALIVE=-1
OLLAMA_FRESH_RUNNER=false
LLM_RESPONSE_CACHE_DEFAULT=false
LLM_RESPONSE_CACHE_MAX_SIZE=128

# Only RAGAS faithfulness evaluation uses the Gemini API.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT_SECONDS=300
# answer relevancy 앙상블 크기. 2 이상이면 RAGAS가 temperature 0.3을 강제하므로
# GEMINI_TEMPERATURE=0과 무관하게 실행마다 값이 달라지고, 변동폭은 답변이 길수록
# 커진다(271자 답변이 0.779~0.814). 반대로 1은 재현되지만 생성 질문 하나가 점수를
# 결정해 질의 수가 적으면 편향이 상쇄되지 않는다. 비교 기준을 맞추려고 5로 둔다.
RAGAS_ANSWER_RELEVANCY_STRICTNESS=5

# AutoMerge에서 여러 EU가 같은 parent를 가리킬 때 본문을 한 번만 실을지 여부.
# 켜면 토큰이 줄지만 Small-to-Big 쪽 근거만 27.6% 줄어들어(5개 질의 측정)
# ROI-RAG와의 비교가 불공정해진다. 비교 실험 중에는 꺼 둔다.
STB_PARENT_DEDUP=false

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNKING_STRATEGY=roi_rag