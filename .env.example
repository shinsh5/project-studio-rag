LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama2:7b
OLLAMA_TEMPERATURE=0.0
OLLAMA_SEED=42
OLLAMA_TOP_K=1
OLLAMA_TOP_P=1.0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_BATCH=32
OLLAMA_KEEP_ALIVE=-1
OLLAMA_FRESH_RUNNER=false
LLM_RESPONSE_CACHE_DEFAULT=false
LLM_RESPONSE_CACHE_MAX_SIZE=128

# Only RAGAS faithfulness evaluation uses the Gemini API.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT_SECONDS=300
# answer relevancy 앙상블 크기. 2 이상이면 RAGAS가 temperature 0.3을 강제하므로
# GEMINI_TEMPERATURE=0과 무관하게 실행마다 값이 달라진다. 변동폭은 답변이 길수록
# 커서, 271자 답변이 strictness 5에서 0.779~0.814로 흔들렸다. 이는 전략 간 비교로
# 검출하려던 차이(0.0129)보다 크다. 재현성을 위해 1로 고정한다.
RAGAS_ANSWER_RELEVANCY_STRICTNESS=1

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNKING_STRATEGY=roi_rag