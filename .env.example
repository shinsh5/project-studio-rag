LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama2:7b
OLLAMA_TEMPERATURE=0.0
OLLAMA_SEED=42
OLLAMA_TOP_K=1
OLLAMA_TOP_P=1.0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_BATCH=32
OLLAMA_KEEP_ALIVE=-1
OLLAMA_FRESH_RUNNER=false
LLM_RESPONSE_CACHE_DEFAULT=true
LLM_RESPONSE_CACHE_MAX_SIZE=128

# Only RAGAS faithfulness evaluation uses the Gemini API.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT_SECONDS=300
# answer relevancy 앙상블 크기. 1이면 완전 재현되지만 단일 표본 편향이 생기고,
# 2 이상이면 RAGAS가 temperature 0.3을 강제해 실행마다 값이 달라진다.
# 5회 반복 측정 표준편차: strictness 1 -> 0.0000, 3 -> 0.0155, 5 -> 0.0077
RAGAS_ANSWER_RELEVANCY_STRICTNESS=5

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNKING_STRATEGY=roi_rag